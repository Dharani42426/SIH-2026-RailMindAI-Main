# ═══════════════════════════════════════════════════════════════
# RailMind AI — Environment Variables
# Copy this to .env and modify as needed
# ═══════════════════════════════════════════════════════════════

# ─── App Settings ───
APP_NAME=RailMind AI
DEBUG=True

# ─── Database ───
# For local development (SQLite, no setup needed):
DATABASE_URL=sqlite:///./railmind.db

# For Docker/Production (PostgreSQL):
# DATABASE_URL=postgresql://railmind_user:railmind_pass_2026@db:5432/railmind

# ─── Redis (optional for local dev) ───
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# ─── AI Settings ───
OPTIMIZER_MAX_SOLVE_TIME_SECONDS=5
MAX_BLOCKS_PER_SECTION_PER_DAY=2
MIN_GAP_BETWEEN_BLOCKS_MINUTES=30

# ─── NLP Settings ───
# ─── NLP Settings ───
NLP_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:235b
OLLAMA_TIMEOUT_SECONDS=120
