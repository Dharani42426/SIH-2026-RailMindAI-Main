# ═══════════════════════════════════════════════════════════════
# RailMind AI — Backend .gitignore
# ═══════════════════════════════════════════════════════════════

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# Database files (local SQLite)
*.db
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/

# Test & coverage
.pytest_cache/
htmlcov/
.coverage

# NOTE: ai_models/ is intentionally tracked.
# Trained models are project artifacts needed for the demo.
